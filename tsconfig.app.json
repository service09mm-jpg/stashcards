{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // Останній запис — не для застосунку, а для тестів: він дописує до
    // `expect` матчери на кшталт `toBeInTheDocument`. Тести лежать поруч із
    // кодом, який перевіряють, тож і проєкт у них спільний.
    "types": ["vite/client", "vite-plugin-pwa/client", "@testing-library/jest-dom/vitest"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"]
}
